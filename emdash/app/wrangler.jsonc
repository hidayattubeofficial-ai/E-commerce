{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fm-ecommerce-emdash",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-09-29",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB", "database_name": "fm-ecommerce-emdash" }
  ],
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "fm-ecommerce-emdash-media" }
  ],
  "triggers": { "crons": ["0 * * * *"] }
}