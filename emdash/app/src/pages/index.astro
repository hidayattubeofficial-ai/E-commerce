---
const title = "FM E-commerce";
const tagline = "EmDash + Astro + Cloudflare foundation";
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <meta name="description" content={tagline} />
  </head>
  <body>
    <main>
      <h1>{title}</h1>
      <p>{tagline}</p>
      <p>CMS: <a href="/_emdash/admin">EmDash Admin</a></p>
      <p>Production deployment: OFF · Human approval: ON</p>
    </main>
  </body>
</html>